node_modules/
dist/
# Environment. Every env file is ignored by default; the committed .env.local is un-ignored by
# negation. It holds only declared config and 1Password op:// references — `npm run check:env`
# (part of check:all) fails on anything else. The generated .env.staging / .env.prod hold real
# values and stay out.
.env*
!.env.local
*.log
.DS_Store
coverage/
*.tsbuildinfo

# spec-render output — derived views beside each Spec Kit .md.
# Markdown stays the source of truth; regenerate with `spec-render`, remove with
# `spec-render --clean`.
specs/**/*.html

# Extension local config — real space/list names, never the shipped placeholders
.specify/extensions/*/config.local.yml

# Local development database (npm run db:up)
.pgdata/
